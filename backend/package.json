{
  "name": "churu-results-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Churu ZP-PS election results portal - backend",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "migrate": "tsx src/db/migrate.ts latest",
    "migrate:rollback": "tsx src/db/migrate.ts rollback",
    "migrate:test": "tsx src/db/migrate.ts latest --test"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "mysql2": "3.24.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
