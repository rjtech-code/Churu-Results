# Copy to .env.production on the server (chmod 600). NEVER commit it.
# Generate each secret with ONE command (run it once per secret):
#   openssl rand -base64 36 | tr -d '/+='
# Passwords must be at least 12 chars and use only letters/digits (safe for shell and SQL).

NODE_ENV=production
PORT=3100
# Exact public URL (https, no trailing slash). Change to the real subdomain.
APP_ORIGIN=https://chunav.example.com
# Session cookie signing secret (at least 32 chars)
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=14
# 1 = trust exactly one proxy hop (the host Nginx). Docker NAT shows the bridge IP, so "loopback" would not work.
TRUST_PROXY=1
# Booth total <= registered voters needs voter counts (empty = true in production)
REQUIRE_VOTER_COUNTS=

SSE_MAX_CONNECTIONS=50
PUBLIC_MIN_SNAPSHOT_INTERVAL_MS=2000
PUBLIC_RATE_LIMIT_PER_MIN=3000
FRONTEND_DIST=../frontend/dist

# Database (compose overrides DB_HOST=mysql, DB_PORT=3306 for the app container)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=churu_prod
# Required by the init script; not used in production
DB_NAME_TEST=churu_prod_test
DB_APP_USER=churu_app
DB_APP_PASSWORD=
DB_MIGRATION_USER=churu_migrator
DB_MIGRATION_PASSWORD=
MYSQL_ROOT_PASSWORD=
