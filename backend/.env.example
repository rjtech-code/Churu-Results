# Copy to backend/.env and fill in. NEVER commit backend/.env.
# This file is also read by docker-compose (env_file) to create the MySQL databases and users.
# Generate strong passwords with:  openssl rand -base64 24 | tr -d '/+='

# --- App ---
# Runtime mode: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=3000

# --- Login sessions and security (Part 3) ---
# Secret that signs the churu.sid session cookie; at least 32 random chars (openssl rand -base64 48)
SESSION_SECRET=
# The exact origin the browser uses for this site (scheme://host[:port], no trailing slash);
# state-changing requests with any other Origin header are refused.
#   Dev with the Vite server (npm run dev in frontend/):  http://localhost:5173
#   Built dashboard served by the backend:                 the URL operators type, e.g. http://localhost:3000
#   Counting day behind Caddy (HTTPS):                      https://<server name>
APP_ORIGIN=http://localhost:5173
# Minutes of inactivity before a session ends (whole number 1-120; at least 5 in production)
SESSION_IDLE_MINUTES=30
# Hours after login when a session ends even if active (whole number 1-24)
SESSION_ABSOLUTE_HOURS=14
# Rule 7 (booth total <= registered voters) needs voter counts. true: a booth without a count cannot be
# entered. false: allowed with a warning (in production: startup warning + audit row). Empty = true in production.
REQUIRE_VOTER_COUNTS=
# Reverse proxy in front of the app: false (none), loopback (Caddy on this server) or a hop count. Never true.
TRUST_PROXY=false

# --- Public media-room screens (Part 7) ---
# Max simultaneous live-update (SSE) streams; above it new screens get 503 TOO_MANY_STREAMS
SSE_MAX_CONNECTIONS=50
# Minimum milliseconds between two published result snapshots (changes in between are merged)
PUBLIC_MIN_SNAPSHOT_INTERVAL_MS=2000
# Public GET requests per minute per IP (the 3 TVs may share one IP)
PUBLIC_RATE_LIMIT_PER_MIN=3000

# --- Operator dashboard (Part 8) ---
# Folder of the built dashboard (npm run build in frontend/), relative to backend/. If it has no
# index.html the server runs API-only. In dev you use the Vite server instead (see README).
FRONTEND_DIST=../frontend/dist

# --- Database connection (from the host to the Docker MySQL) ---
# MySQL host (Docker publishes MySQL on localhost only)
DB_HOST=127.0.0.1
# MySQL port on the host (3307, because a local MySQL already uses 3306)
DB_PORT=3307
# Development database used by the app and `npm run migrate`
DB_NAME=churu_dev
# Test database used by `npm test` / `npm run migrate:test`; MUST end with _test
DB_NAME_TEST=churu_test

# --- App DB user: least privilege (SELECT/INSERT/UPDATE/DELETE per table; audit_log SELECT/INSERT only) ---
# Username of the runtime app user (a-z, 0-9, _)
DB_APP_USER=churu_app
# Password of the runtime app user (min 12 chars)
DB_APP_PASSWORD=

# --- Migration DB user: schema changes + grants only; never used by the running app ---
# Username of the migration user (a-z, 0-9, _)
DB_MIGRATION_USER=churu_migrator
# Password of the migration user (min 12 chars)
DB_MIGRATION_PASSWORD=

# --- Docker only ---
# MySQL root password for the container (not used by the app or migrations)
MYSQL_ROOT_PASSWORD=
