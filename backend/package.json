{
  "name": "churu-results-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Churu ZP-PS election results portal - backend",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "migrate": "tsx src/db/migrate.ts latest",
    "migrate:rollback": "tsx src/db/migrate.ts rollback",
    "migrate:test": "tsx src/db/migrate.ts latest --test",
    "import:geography": "tsx scripts/import-geography.ts",
    "import:parties": "tsx scripts/import-parties.ts",
    "export:voter-template": "tsx scripts/export-voter-template.ts",
    "import:voters": "tsx scripts/import-voters.ts",
    "import:candidates": "tsx scripts/import-candidates.ts",
    "ballot:report": "tsx scripts/ballot-report.ts",
    "ballot:lock": "tsx scripts/ballot-lock.ts",
    "ballot:unlock": "tsx scripts/ballot-unlock.ts",
    "users:create": "tsx scripts/users-create.ts",
    "users:reset-password": "tsx scripts/users-reset-password.ts",
    "users:disable": "tsx scripts/users-set-active.ts disable",
    "users:enable": "tsx scripts/users-set-active.ts enable",
    "users:list": "tsx scripts/users-list.ts",
    "templates:generate": "tsx scripts/generate-templates.ts",
    "test:coverage": "vitest run --coverage tests/result",
    "result:ward": "tsx scripts/result-ward.ts",
    "users:unlock": "tsx scripts/users-unlock.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "screens:show": "tsx scripts/screens-show.ts",
    "screens:set": "tsx scripts/screens-set.ts",
    "demo:simulate": "tsx scripts/demo-simulate.ts",
    "ps:set-hindi-names": "tsx scripts/ps-set-hindi-names.ts"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "dotenv": "18.0.5",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-mysql-session": "3.0.3",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "mysql2": "3.24.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/express-mysql-session": "3.0.8",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "express-mysql-session": {
      "mysql2": "$mysql2"
    },
    "@types/express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
